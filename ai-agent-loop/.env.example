# Required: your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Never commit your real .env file.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model to use. Defaults to claude-sonnet-4-5-20250929 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: maximum agent loop iterations before it force-stops. Default 10.
MAX_ITERATIONS=10

# Optional: sandboxed directory the file-reader/file-writer tools may access.
# Defaults to ./workspace
WORKSPACE_DIR=./workspace

# Optional: directory where run logs (JSON/JSONL) are saved. Defaults to ./runs
RUNS_DIR=./runs

# Optional: Brave Search API key (https://brave.com/search/api/) to enable
# the web_search tool. Leave unset to keep web search disabled -- the agent
# will get a clear "not configured" error if it tries to use it, and will
# never fabricate search results.
SEARCH_API_KEY=

# Optional: per-request timeout (seconds) for Anthropic API calls. Default 60.
REQUEST_TIMEOUT_SECONDS=60
